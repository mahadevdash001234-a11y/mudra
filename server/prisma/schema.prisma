// Prisma Schema for Loan Approve Platform
// Database: SQLite with WAL mode enabled

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. ADMIN USER
// -------------------------------------------------------------
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         String    @default("STAFF") // SUPER_ADMIN, ADMIN, STAFF
  permissions  String?   @db.Text // JSON string array of granted permission keys
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  disbursements Disbursement[]
}

// -------------------------------------------------------------
// 2. CUSTOMER
// -------------------------------------------------------------
model Customer {
  id              String    @id @default(uuid())
  mobile          String    @unique
  fullName        String
  email           String
  passwordHash    String?
  fatherName      String?
  gender          String?
  dob             String?
  address         String    @db.Text
  state           String
  city            String
  pincode         String?
  aadhaarEncrypted String
  aadhaarMasked   String
  panEncrypted    String?
  panMasked       String?
  monthlyIncome   Float
  bankName        String?
  bankAccountNumber String?
  bankIfsc        String?
  bankBranch      String?
  bankAccountType String?
  domainId        String?
  domain          Domain?   @relation(fields: [domainId], references: [id], onDelete: SetNull)
  status          String    @default("ACTIVE") // ACTIVE, SUSPENDED, ARCHIVED, DEACTIVATED
  kycStatus       String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, REUPLOAD_REQUIRED
  isActive        Boolean   @default(true)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  loans           LoanApplication[]
  documents       LoanDocument[]
  documentRequests DocumentRequest[]
  agreements      LoanAgreement[]
  disbursements   Disbursement[]
  emiSchedules    EMISchedule[]
  payments        Payment[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  charges         Charge[]
  invoices        Invoice[]
  whatsappMessages WhatsAppMessage[]
  emailMessages   EmailMessage[]

  @@index([mobile])
  @@index([email])
  @@index([state])
  @@index([city])
  @@index([kycStatus])
  @@index([createdAt])
  @@index([domainId])
}

// -------------------------------------------------------------
// 3. LOAN APPLICATION & LOAN
// -------------------------------------------------------------
model LoanApplication {
  id                   String    @id @default(uuid())
  applicationNumber    String    @unique // e.g. LA-2026-000001
  accountNumber        String?   // e.g. LN20260906142729
  approvalNumber       String?   // e.g. LN20260906142729
  loanType             String?   @default("Personal Loan")
  customerId           String
  customer             Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  requestedAmount      Float
  proposedAmount       Float?    // Admin proposed amount in offer workflow
  approvedAmount       Float?
  acceptedAmount       Float?    // Customer accepted offer amount
  
  interestType         String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  interestRate         Float     @default(12.0)
  interestCalcMethod   String    @default("REDUCING_BALANCE") // SIMPLE, REDUCING_BALANCE
  
  processingFeeType    String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  processingFeeValue   Float     @default(2.0)
  processingFeeAmount  Float     @default(0)
  insuranceAmount      Float?    @default(0)
  totalPayable         Float?
  remainingBalance     Float?
  
  tenureMonths         Int
  estimatedEmi         Float?    @default(0)
  finalEmi             Float?
  disbursementDate     DateTime?
  nextEmiDate          DateTime?
  
  purpose              String?   @db.Text
  status               String    @default("SUBMITTED") 
  // DRAFT, SUBMITTED, UNDER_REVIEW, DOCUMENTS_REQUIRED, ON_HOLD, APPROVED, 
  // REJECTED, OFFER_PENDING_CUSTOMER, OFFER_ACCEPTED, OFFER_REJECTED

  rejectionReason      String?   @db.Text
  holdReason           String?   @db.Text
  docRequestReason     String?   @db.Text
  modifiedOfferAccepted Boolean?
  paymentStatus        String    @default("NOT_REQUIRED") // NOT_REQUIRED, PAYMENT_REQUIRED, UNDER_VERIFICATION, PAID
  
  domainId             String?
  domain               Domain?   @relation(fields: [domainId], references: [id], onDelete: SetNull)

  reviewedBy           String?
  reviewedAt           DateTime?
  submittedAt          DateTime? @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  documents            LoanDocument[]
  documentRequests     DocumentRequest[]
  agreement            LoanAgreement?
  disbursements        Disbursement[]
  emiSchedules         EMISchedule[]
  payments             Payment[]
  charges              Charge[]
  invoices             Invoice[]
  whatsappMessages     WhatsAppMessage[]
  emailMessages        EmailMessage[]

  @@index([applicationNumber])
  @@index([accountNumber])
  @@index([approvalNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([submittedAt])
  @@index([domainId])
}

// -------------------------------------------------------------
// 4. LOAN DOCUMENT & KYC
// -------------------------------------------------------------
model LoanDocument {
  id               String           @id @default(uuid())
  loanId           String?
  loan             LoanApplication? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  documentType     String           // AADHAAR_FRONT, AADHAAR_BACK, PAN, INCOME_PROOF, BANK_STATEMENT, OTHER
  fileName         String           // Display filename
  originalFileName String           @default("")
  storageKey       String           @default("")
  filePath         String           @db.Text
  fileUrl          String           @db.Text
  mimeType         String
  fileSize         Int
  status           String           @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, REUPLOAD_REQUIRED
  rejectionReason  String?          @db.Text
  version          Int              @default(1)
  isCurrentVersion Boolean          @default(true)
  reviewedBy       String?
  reviewedAt       DateTime?
  uploadedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @default(now()) @updatedAt

  @@index([customerId])
  @@index([loanId])
  @@index([documentType])
  @@index([status])
  @@index([isCurrentVersion])
}

// -------------------------------------------------------------
// 4b. DOCUMENT REQUEST (Admin initiated)
// -------------------------------------------------------------
model DocumentRequest {
  id           String           @id @default(uuid())
  customerId   String
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  loanId       String?
  loan         LoanApplication? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  documentType String           // e.g. OTHER, BANK_STATEMENT, etc.
  title        String
  description  String?          @db.Text
  status       String           @default("PENDING") // PENDING, FULFILLED, CANCELLED
  requestedBy  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([customerId])
  @@index([loanId])
  @@index([status])
}

// -------------------------------------------------------------
// 5. LOAN AGREEMENT
// -------------------------------------------------------------
model LoanAgreement {
  id                   String          @id @default(uuid())
  loanId               String          @unique
  loan                 LoanApplication @relation(fields: [loanId], references: [id], onDelete: Restrict)
  customerId           String
  customer             Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  agreementVersion     String          @default("v1.0")
  agreementContentHtml String          @db.LongText
  ipAddress            String?
  userAgent            String?
  acceptanceStatus     String          @default("PENDING") // PENDING, ACCEPTED
  acceptedAt           DateTime?
  createdAt            DateTime        @default(now())

  @@index([loanId])
  @@index([customerId])
}

// -------------------------------------------------------------
// 6. DISBURSEMENT
// -------------------------------------------------------------
model Disbursement {
  id                String          @id @default(uuid())
  loanId            String
  loan              LoanApplication @relation(fields: [loanId], references: [id], onDelete: Restrict)
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  amount            Float
  method            String          // BANK_TRANSFER, UPI
  referenceId       String          // UTR or Transaction Ref
  status            String          @default("COMPLETED") // PENDING, COMPLETED, FAILED
  notes             String?         @db.Text
  disbursedAt       DateTime        @default(now())
  
  createdByAdminId  String?
  admin             AdminUser?      @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([loanId])
  @@index([customerId])
  @@index([referenceId])
}

// -------------------------------------------------------------
// 7. EMI SCHEDULE
// -------------------------------------------------------------
model EMISchedule {
  id                String          @id @default(uuid())
  loanId            String
  loan              LoanApplication @relation(fields: [loanId], references: [id], onDelete: Restrict)
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  installmentNumber Int
  dueDate           DateTime
  principalAmount   Float
  interestAmount    Float
  totalAmount       Float
  paidAmount        Float           @default(0)
  status            String          @default("UPCOMING") // UPCOMING, DUE, PAID, PARTIALLY_PAID, OVERDUE
  paidAt            DateTime?

  payments          Payment[]

  @@index([loanId])
  @@index([customerId])
  @@index([dueDate])
  @@index([status])
}

// -------------------------------------------------------------
// 8. PAYMENT & REPAYMENT
// -------------------------------------------------------------
model Payment {
  id             String          @id @default(uuid())
  loanId         String
  loan           LoanApplication @relation(fields: [loanId], references: [id], onDelete: Restrict)
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  emiScheduleId  String?
  emiSchedule    EMISchedule?    @relation(fields: [emiScheduleId], references: [id], onDelete: SetNull)
  
  amount         Float
  paymentMethod  String          // UPI, NET_BANKING, DEBIT_CARD, MOCK
  paymentType    String          @default("PROCESSING_FEE") // PROCESSING_FEE, EMI_REPAYMENT
  transactionRef String          @unique
  receiptNumber  String          @unique
  status         String          @default("SUCCESS") // PENDING, UNDER_VERIFICATION, SUCCESS, PAID, FAILED, REJECTED
  verifiedBy     String?
  verifiedAt     DateTime?
  rejectionReason String?        @db.Text
  notes          String?         @db.Text
  chargeId       String?
  upiVpa         String?
  submittedAt    DateTime?
  paymentDate    DateTime        @default(now())

  @@index([loanId])
  @@index([customerId])
  @@index([transactionRef])
  @@index([receiptNumber])
  @@index([status])
}

// -------------------------------------------------------------
// 9. NOTIFICATION
// -------------------------------------------------------------
model Notification {
  id            String    @id @default(uuid())
  recipientType String    // CUSTOMER, ADMIN
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  title         String
  message       String    @db.Text
  eventType     String    // REGISTRATION, LOAN_STATUS, EMI_REMINDER, etc.
  isRead        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([recipientType])
  @@index([customerId])
  @@index([isRead])
}

// -------------------------------------------------------------
// 10. AUDIT LOG (Immutable)
// -------------------------------------------------------------
model AuditLog {
  id            String    @id @default(uuid())
  actorType     String    // ADMIN, CUSTOMER, SYSTEM
  actorId       String?
  actorName     String    @default("System Admin")
  action        String    // APPROVE_LOAN, MODIFY_AMOUNT, DISBURSE, CUSTOMER_ACCOUNT_DEACTIVATED, etc.
  entity        String    // LoanApplication, Customer, Document, etc.
  entityId      String
  previousValue String?   @db.LongText   // JSON stringified before state
  newValue      String?   @db.LongText   // JSON stringified after state
  ipAddress     String?
  timestamp     DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([timestamp])
  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

// -------------------------------------------------------------
// 11. BRANDING & SYSTEM SETTINGS
// -------------------------------------------------------------
model BrandingSettings {
  id              String   @id @default("default")
  companyName     String   @default("Loan Approve Financial Services")
  appName         String   @default("Loan Approve")
  logoUrl         String?  @db.LongText
  faviconUrl      String?  @db.LongText
  primaryColor    String   @default("#047857")
  secondaryColor  String   @default("#0f172a")
  email           String   @default("support@loanapprove.com")
  phone           String   @default("+91 98765 43210")
  address         String?  @db.Text
  website         String   @default("https://loanapprove.com")
  termsUrl        String   @default("https://loanapprove.com/terms")
  privacyUrl      String   @default("https://loanapprove.com/privacy")
  companyLegalName String   @default("Loan Approve Financial Services Pvt. Ltd.")
  authorizedSignatoryName String @default("Authorized Underwriting Officer")
  authorizedSignatoryDesignation String @default("Credit & Sanction Division")
  authorizedSignatureUrl String? @db.LongText
  companyStampUrl String? @db.LongText

  // ── Document & PDF Branding (Approval Letter & Invoice) ───────
  approvalLetterHeaderUrl   String?  @db.LongText // Complete 1024x232 banner artwork for top of Approval Letter
  secondaryLogoUrl          String?  @db.LongText // Secondary PNG / side scheme logo
  watermarkLogoUrl          String?  @db.LongText // Background watermark logo (300x300 emblem)
  documentWatermarkEnabled  Boolean  @default(true) // Watermark ON/OFF for Approval Letter
  invoiceWatermarkEnabled   Boolean  @default(true) // Watermark ON/OFF for Tax Invoices
  watermarkOpacity          Float    @default(0.10) // Range: 0.05 - 0.30 (default 10%)
  watermarkSize             String   @default("MEDIUM") // "SMALL", "MEDIUM", "LARGE"
  watermarkPosition         String   @default("CENTER") // "CENTER", "TOP", "BOTTOM"

  // ── Website / Landing Page Configuration ──────────────────────
  // Lender / Financial Partner Disclosure
  lenderName                String?  // Configurable — do NOT hardcode
  lenderLegalName           String?
  lenderRegistrationNumber  String?  // e.g. NBFC registration — only if verified
  lenderType                String?  // e.g. "NBFC", "Bank", "MFI"
  lenderAddress             String?  @db.Text
  lenderWebsite             String?
  isDirectLender            Boolean  @default(false)
  partnerName               String?
  partnerRelationship       String?  // e.g. "Loan Facilitator / DSA"

  // Loan Financial Parameters (shown on landing page & EMI calculator)
  minLoanAmount             Float    @default(10000)
  maxLoanAmount             Float    @default(3000000)
  minTenureMonths           Int      @default(6)
  maxTenureMonths           Int      @default(84)
  minApr                    Float    @default(12.0)
  maxApr                    Float    @default(36.0)
  processingFeePolicy       String?  @db.Text
  otherChargesPolicy        String?  @db.Text

  // Eligibility Configuration
  minAge                    Int      @default(18)
  maxAge                    Int      @default(60)
  minMonthlyIncome          Float    @default(15000)
  creditScoreCriteria       String?  @db.Text
  bankAccountRequired       Boolean  @default(true)
  employmentCriteria        String?  @db.Text
  residentialStatusCriteria String?  @db.Text

  // Document Checklist (JSON array of {id, name, description, icon, enabled, mandatory})
  documentsConfigJson       String?  @db.LongText

  // Disclaimer & Legal (Page 5 from PDF)
  disclaimerText            String?  @db.Text

  // FAQs (JSON array of {question, answer})
  faqsJson                  String?  @db.LongText

  // Mobile App CTA
  appEnabled                Boolean  @default(false)
  appDownloadUrl            String?

  // Hero Content
  heroHeadline              String?  @db.Text
  heroSubheadline           String?  @db.Text

  updatedAt       DateTime @updatedAt
}

// -------------------------------------------------------------
// 12. SUPPORT TICKET
// -------------------------------------------------------------
model SupportTicket {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subject     String
  message     String    @db.Text
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  adminReply  String?   @db.Text
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  emailMessages EmailMessage[]

  @@index([customerId])
  @@index([status])
}

// -------------------------------------------------------------
// 13. EMAIL SETTINGS (SMTP)
// -------------------------------------------------------------
model EmailSettings {
  id              String    @id @default("default")
  smtpHost        String    @default("")
  smtpPort        Int       @default(587)
  smtpUsername    String    @default("")
  smtpPasswordEnc String    @default("")
  fromName        String    @default("Loan Approve Financial Services")
  fromEmail       String    @default("notifications@loanapprove.com")
  replyToEmail    String    @default("")
  encryption      String    @default("STARTTLS") // NONE, SSL, STARTTLS
  enabled         Boolean   @default(true)
  status          String    @default("NOT_CONFIGURED") // NOT_CONFIGURED, CONFIGURED, CONNECTED, CONNECTION_FAILED
  lastTestedAt    DateTime?
  lastError       String?   @db.Text
  updatedAt       DateTime  @updatedAt
}

// -------------------------------------------------------------
// 14. WHATSAPP SETTINGS
// -------------------------------------------------------------
model WhatsAppSettings {
  id                String    @id @default("default")
  provider          String    @default("WABRIDGE") // WABRIDGE, META, TWILIO, GUPSHUP
  phoneNumber       String    @default("")
  phoneNumberId     String    @default("")
  businessAccountId String    @default("")
  apiEndpoint       String    @default("")
  apiBaseUrl        String    @default("")
  sendEndpoint      String    @default("")
  authType          String    @default("BEARER") // BEARER, API_KEY, CUSTOM_HEADER, NONE
  apiKeyHeaderName  String    @default("x-api-key")
  authHeaderPrefix  String    @default("Bearer")
  accessTokenEnc    String    @default("")
  enabled           Boolean   @default(false)
  status            String    @default("NOT_CONFIGURED") // NOT_CONFIGURED, CONFIGURED, CONNECTED, CONNECTION_FAILED
  lastTestedAt      DateTime?
  lastError         String?   @db.Text
  updatedAt         DateTime  @updatedAt
}

// -------------------------------------------------------------
// 15. PAYMENT CONFIGURATION
// -------------------------------------------------------------
model PaymentConfig {
  id                String   @id @default("default")
  chargeAmount      Float    @default(500)
  chargeType        String   @default("PROCESSING_DEPOSIT") // PROCESSING_DEPOSIT, VERIFICATION_FEE
  upiId             String   @default("pay@loanapprove")
  accountNumber     String   @default("9876543210123")
  ifscCode          String   @default("HDFC0001234")
  accountHolderName String   @default("Loan Approve Financial Services")
  instructions      String?  @db.Text
  defaultInterestRate Float  @default(12.0)
  kycChargeAmount     Float  @default(499)
  processingFeeAmount Float  @default(1999)
  loanDocFeeEnabled   Boolean @default(false)
  loanDocFeeAmount    Float   @default(999)
  updatedAt         DateTime @updatedAt
}

// -------------------------------------------------------------
// 16. DOMAIN MANAGEMENT (Multi-tenant)
// -------------------------------------------------------------
model Domain {
  id              String            @id @default(uuid())
  domainName      String            @unique
  helplineNumber  String?           @default("+91 8042054797")
  contactEmail    String?           @default("contact@loanapprove.com")
  description     String?           @db.Text
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  customers       Customer[]
  loans           LoanApplication[]

  @@index([domainName])
  @@index([isActive])
}

// -------------------------------------------------------------
// 17. PAYMENT LINKS
// -------------------------------------------------------------
model PaymentLink {
  id          String   @id @default(uuid())
  title       String
  url         String
  description String?  @db.Text
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// -------------------------------------------------------------
// 18. CHARGES & FEES
// -------------------------------------------------------------
model Charge {
  id          String           @id @default(uuid())
  name        String
  amount      Float
  type        String           @default("FIXED") // FIXED, PERCENTAGE
  isMandatory Boolean          @default(true)
  isActive    Boolean          @default(true)
  taxPercent  Float            @default(18.0)
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loanId      String?
  loan        LoanApplication? @relation(fields: [loanId], references: [id], onDelete: Cascade)
  status      String           @default("PENDING") // PENDING, PAID, FAILED, CANCELLED
  remark      String?          @db.Text
  dueDate     DateTime?
  createdBy   String?
  paidAt      DateTime?
  transactionRef String?
  paymentId   String?
  sentAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([customerId])
  @@index([loanId])
  @@index([isActive])
}

// -------------------------------------------------------------
// 19. ADVANCED UPI SETTINGS
// -------------------------------------------------------------
model UPISettings {
  id               String   @id @default("default")
  upiEnabled       Boolean  @default(false)
  upiId            String   @default("")
  merchantName     String?  @default("")
  gpayEnabled      Boolean  @default(false)
  gpayId           String   @default("")
  phonepeEnabled   Boolean  @default(false)
  phonepeId        String   @default("")
  paytmEnabled     Boolean  @default(false)
  paytmId          String   @default("")
  otherUpiEnabled  Boolean  @default(false)
  otherUpiId       String   @default("")
  qrCodeUrl        String?
  updatedAt        DateTime @updatedAt
}

// -------------------------------------------------------------
// 20. ADVANCED BANK SETTINGS
// -------------------------------------------------------------
model BankSettings {
  id            String   @id @default("default")
  bankEnabled   Boolean  @default(true)
  accountHolder String   @default("Loan Approve Financial Services Pvt Ltd")
  accountNumber String   @default("50200084729104")
  bankName      String   @default("HDFC Bank")
  ifsc          String   @default("HDFC0000060")
  branch        String   @default("Fort, Mumbai")
  updatedAt     DateTime @updatedAt
}

// -------------------------------------------------------------
// 21. VERIFICATION TOKEN (QR Code & Public Verification)
// -------------------------------------------------------------
model VerificationToken {
  id                String   @id @default(uuid())
  token             String   @unique
  documentType      String   @default("APPROVAL_LETTER")
  entityId          String   // Loan ID or Document ID
  customerName      String
  applicationNumber String
  loanAccountNumber String
  approvalDate      DateTime @default(now())
  status            String   @default("VERIFIED")
  createdAt         DateTime @default(now())

  @@index([token])
  @@index([entityId])
}

// -------------------------------------------------------------
// 22. WHATSAPP MESSAGE (Communication History)
// -------------------------------------------------------------
model WhatsAppMessage {
  id                String           @id @default(uuid())
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loanId            String?
  loan              LoanApplication? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  adminId           String?
  phone             String
  message           String           @db.Text
  templateName      String?
  providerMessageId String?
  status            String           @default("SENT") // SENT, DELIVERED, FAILED
  sentAt            DateTime?        @default(now())
  failedAt          DateTime?
  failureReason     String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([customerId])
  @@index([loanId])
  @@index([status])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 23. EMAIL MESSAGE (Customer Communication Center)
// -------------------------------------------------------------
model EmailMessage {
  id                String           @id @default(uuid())
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  loanId            String?
  loan              LoanApplication? @relation(fields: [loanId], references: [id], onDelete: SetNull)
  ticketId          String?
  ticket            SupportTicket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  adminId           String?
  recipientEmail    String
  subject           String
  message           String           @db.Text
  templateName      String?
  status            String           @default("SENT") // SENT, FAILED, PENDING
  providerMessageId String?
  sentAt            DateTime?        @default(now())
  failedAt          DateTime?
  failureReason     String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([customerId])
  @@index([loanId])
  @@index([ticketId])
  @@index([status])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 24. COMMUNICATION SETTINGS (Automated Event Configuration)
// -------------------------------------------------------------
model CommunicationSettings {
  id                            String   @id @default("default")
  emailEnabled                  Boolean  @default(false)
  whatsAppEnabled               Boolean  @default(false)
  autoEmailOnPaymentVerified    Boolean  @default(true)
  autoEmailOnLoanApproved       Boolean  @default(true)
  autoEmailOnLoanRejected       Boolean  @default(true)
  autoEmailOnKycVerified        Boolean  @default(true)
  autoEmailOnKycRejected        Boolean  @default(true)
  autoEmailOnChargeCreated      Boolean  @default(true)
  autoWhatsAppOnPaymentVerified Boolean  @default(false)
  autoWhatsAppOnKycPending      Boolean  @default(false)
  autoWhatsAppOnLoanApproved    Boolean  @default(false)
  autoWhatsAppOnLoanRejected    Boolean  @default(false)
  autoWhatsAppOnChargeCreated   Boolean  @default(false)
  updatedAt                     DateTime @updatedAt
}

// -------------------------------------------------------------
// 25. INVOICE (Persisted Individual Fee / Charge Invoices)
// -------------------------------------------------------------
model Invoice {
  id                 String           @id @default(uuid())
  invoiceNumber      String           @unique // e.g. INV-2026-000001
  customerId         String
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  loanId             String?
  loan               LoanApplication? @relation(fields: [loanId], references: [id], onDelete: Restrict)
  chargeId           String?          @unique // 1 Charge = 1 Invoice idempotency
  paymentId          String?
  chargeName         String
  amount             Float
  taxAmount          Float            @default(0)
  totalAmount        Float
  currency           String           @default("INR")
  status             String           @default("PAID") // PAID, ISSUED, VOID
  storageKey         String
  filePath           String           @db.Text
  fileUrl            String           @db.Text
  templateVersion    String           @default("v1.0")
  brandingVersion    String           @default("v1.0")
  issuedAt           DateTime         @default(now())
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([customerId])
  @@index([loanId])
  @@index([chargeId])
  @@index([paymentId])
  @@index([invoiceNumber])
}


