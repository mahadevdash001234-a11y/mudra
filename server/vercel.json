{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "node_modules/pdfkit/js/standard-fonts/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
