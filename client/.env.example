# Backend API Endpoint Configuration
# Local Development: /api (proxied automatically to localhost:5000 by Vite)
# Production Vercel Frontend: https://mudra-server.vercel.app/api
VITE_API_URL=/api
VITE_APP_NAME="Loan Approve"

# Frontend Deployment Mode
# - all      : Full unified application with all routes (Default / Local Development)
# - admin    : Admin Vercel deployment (mounts /admin/*, redirects / to /admin/dashboard, customer routes excluded)
# - customer : Customer Vercel deployment (mounts landing page, customer portal, public links, admin routes excluded)
#
# Examples for Vercel Project Environment Variables:
#   For Admin Project:    VITE_APP_MODE=admin     VITE_API_URL=https://mudra-server.vercel.app/api
#   For Customer Project: VITE_APP_MODE=customer  VITE_API_URL=https://mudra-server.vercel.app/api
VITE_APP_MODE=all
